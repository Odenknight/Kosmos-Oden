{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kosmos-Oden Standalone",
  "version": "0.8.1",
  "identifier": "com.odenknight.kosmos-oden",
  "build": {
    "beforeDevCommand": "node ../scripts/prepare-desktop.mjs",
    "beforeBuildCommand": "node ../scripts/prepare-desktop.mjs",
    "frontendDist": "generated"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kosmos-Oden Standalone",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:4814 http://localhost:4814; worker-src blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
